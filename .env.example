# APES Performance Evaluation System - Environment Variables
# Copy this file to .env.local for local development or configure in Vercel Project Settings

# Supabase Project URL (Required)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous API Key (Required)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------
# EMAIL NOTIFICATIONS (Outlook / any inbox)
# ------------------------------------------------------------
# RESEND_API_KEY is a SERVER-SIDE secret — do NOT put it here.
# Set it in: Supabase Dashboard -> Settings -> Edge Function Secrets
#   Key:   RESEND_API_KEY
#   Value: re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Sign up free at https://resend.com (3,000 emails/month free tier)
# The Edge Function "send-eval-email" uses this key to send emails
# when POD deploys a new evaluation campaign.
# ------------------------------------------------------------
